{
  "name": "@objectos/docs",
  "version": "0.0.0",
  "private": true,
  "description": "ObjectOS Documentation Site",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "fumadocs-mdx && node scripts/gen-route-data.mjs --dev && next dev",
    "gen:zh-hant": "node scripts/gen-zh-hant.mjs",
    "build": "fumadocs-mdx && node scripts/gen-route-data.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "next typegen && fumadocs-mdx && node scripts/gen-route-data.mjs && tsc --noEmit && node scripts/check-frontmatter.mjs",
    "postinstall": "fumadocs-mdx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "fumadocs-core": "16.8.12",
    "fumadocs-mdx": "15.0.7",
    "fumadocs-ui": "16.8.12",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "negotiator": "^1.0.0",
    "opencc-js": "1.3.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
